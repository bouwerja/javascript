{
  "name": "express-backend-api",
  "version": "1.0.0",
  "description": "javascript backend application",
  "homepage": "https://github.com/bouwerja/javascript#readme",
  "bugs": {
    "url": "https://github.com/bouwerja/javascript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bouwerja/javascript.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env.development src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:only": "node --test --test-only \"tests/**/*.test.js\"",
    "test:models": "node --test \"tests/*/models/**/*.test.js\"",
    "test:controllers": "node --test \"tests/*/controllers/**/*.test.js\"",
    "test:integration": "node --test \"tests/*/integration/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bree": "^9.2.9",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^7.1.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}

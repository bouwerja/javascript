  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env.development src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test-jason": "NODE_ENV=test node --env-file=.env.development --test tests/jason/**/*.test.js",
    "test-jason:models": "NODE_ENV=test node --env-file=.env.development --test tests/jason/models/*.test.js",
    "test-jason:controllers": "NODE_ENV=test node --env-file=.env.development --test tests/jason/controllers/*.test.js",
    "test-jason:integration": "NODE_ENV=test node --env-file=.env.development --test tests/jason/integration/*.test.js"
  },
  "dependencies": {
    "bree": "^9.2.9",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^7.1.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11"
  }
}
